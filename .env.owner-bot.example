# Separate Telegram owner bot deployment
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OWNER_BOT_SHARED_SECRET=
PORT=3000
OWNER_BOT_ENABLE_POLLING=true

# Required only if you want to manage Discord from Telegram:
DISCORD_BOT_TOKEN=
GUILD_ID=

# Discord Helper deployment uses these for ticket-owner notifications:
# OWNER_BOT_WEBHOOK_URL=https://your-owner-bot-domain.example/notify
# OWNER_BOT_SHARED_SECRET=same-secret-as-above
